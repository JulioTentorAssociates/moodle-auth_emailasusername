# Files that belong in the repository but not in a release archive.
# `git archive` and GitHub's source downloads honour export-ignore; the ZIP
# submitted to Moodle Marketplace should carry the plugin and nothing else.
# Tests stay in: reviewers run them, and moodle-plugin-ci expects them.
.github/        export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
